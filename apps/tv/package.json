{
  "name": "couch-coach-tv",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.5.0",
  "resolutions": {
    "js-yaml": "^3.15.1",
    "min-document": "^2.19.1",
    "logkitty": "^0.7.1",
    "node-fetch": "^2.6.7",
    "ws": "^8.21.0"
  },
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check",
    "dev": "yarn workspace @multi-tv/expo-multi-tv start",
    "dev:web": "yarn workspace @multi-tv/expo-multi-tv web",
    "dev:android": "yarn workspace @multi-tv/expo-multi-tv android",
    "test": "yarn workspace @multi-tv/expo-multi-tv test",
    "typecheck": "yarn workspace @multi-tv/expo-multi-tv typecheck",
    "build:apk": "bash scripts/build-apk.sh",
    "install:apk": "bash scripts/install-apk.sh",
    "icons": "bash scripts/generate-icons.sh",
    "emulator": "bash scripts/emulator.sh",
    "publish:synthetic": "node scripts/publish-synthetic.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "puppeteer-core": "^25.15.0"
  }
}
