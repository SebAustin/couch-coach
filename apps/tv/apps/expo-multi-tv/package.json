{
  "name": "@multi-tv/expo-multi-tv",
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "android": "EXPO_TV=1 expo run:android",
    "web": "expo start --web --port 8082",
    "dev:web": "expo start --web --port 8082",
    "test": "jest",
    "prebuild": "EXPO_TV=1 expo prebuild -p android --clean",
    "clean": "rm -rf node_modules",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "ios": "expo run:ios",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@multi-tv/shared-ui": "workspace:*",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "mitt": "^3.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81.5-2",
    "react-native-keyevent": "^0.3.2",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-tv-space-navigation": "6.0.0-beta1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@react-native-tvos/config-tv": "^0.0.10",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "19",
    "babel-plugin-module-resolver": "^4.1.0",
    "eslint": "^9.13.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.7.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
